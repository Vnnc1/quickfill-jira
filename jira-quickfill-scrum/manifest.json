{
  "manifest_version": 3,
  "name": "Jira QuickFill SCRUM — Sprint e equipe",
  "version": "4.7.0",
  "description": "SCRUM: saúde da sprint (burndown, previsão, velocidade), quem está com o quê, riscos (impedidas, paradas, fila do QA) e a equipe ao vivo.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "sidePanel",
    "nativeMessaging",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://*.atlassian.net/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Jira QuickFill SCRUM",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "open-quickfill": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Abrir o QuickFill SCRUM na aba atual"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.atlassian.net/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "modal.html",
        "modal.js",
        "modal.css",
        "lib/*.js"
      ],
      "matches": [
        "https://*.atlassian.net/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "modal.html"
  }
}
